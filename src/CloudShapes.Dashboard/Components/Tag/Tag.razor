@namespace CloudShapes.Dashboard.Components

@if (!string.IsNullOrWhiteSpace(Key))
{
    @if (string.IsNullOrWhiteSpace(Value))
    {
        <span class="badge rounded-pill text-bg-primary">@Key</span>
    }
    else
    {
        <div class="btn-group" role="group" aria-label="tag">
            <span class="btn pe-none badge text-bg-primary btn-sm px-2 py-1">@Key</span>
            <span class="btn pe-none badge text-bg-secondary btn-sm px-2 py-1">@Value</span>
        </div>
    }
}

@code {
    [Parameter] public string Key { get; set; } = "";
    [Parameter] public string Value { get; set; } = "";
}
